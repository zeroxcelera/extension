{
  "name": "celera",
  "description": "Fast buy/sell panel for EVM DEX trading terminals, backed by a local self-custody wallet.",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "@scure/bip39": "1.6.0",
    "hash-wasm": "4.12.0",
    "preact": "10.29.8",
    "uqr": "0.1.2",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
